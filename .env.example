ADDR=:8080
# Public URLs (used in billing redirects and to show customers their inbound-webhook URLs).
PUBLIC_URL=http://localhost:8080
WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# --- Required in production ---------------------------------------------------
DATABASE_URL=postgres://aisp:aisp@localhost:5432/aisp?sslmode=disable   # empty = in-memory (dev only)
JWT_SECRET=                 # long random string:  openssl rand -hex 32
SECRETS_KEY=                # encrypts customers' SMTP/IMAP/API credentials at rest:  openssl rand -hex 32
                            # Keep it safe: losing it makes stored credentials unreadable.
REDIS_URL=redis://localhost:6379   # empty = in-process job queue (dev only; jobs lost on restart)

# --- AI (pick one; add a fallback if you like) ----------------------------------
AI_PROVIDER=                # anthropic | openai | mock   (auto-detected from the keys below; mock if none)
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=             # also any OpenAI-compatible server (Ollama, vLLM, OpenRouter): set OPENAI_BASE_URL
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
AI_FALLBACK_PROVIDER=       # e.g. openai: used automatically if the primary fails
AI_FALLBACK_MODEL=

# --- Billing (Stripe) ------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=      # endpoint: POST $PUBLIC_URL/v1/billing/webhook
                            # events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# --- Operation ------------------------------------------------------------------------
SCHEDULER_INTERVAL=1m       # how often agents on autopilot and mailboxes are serviced; 0 disables
WORKERS=4
TRUST_PROXY=false           # true only behind a reverse proxy that sets X-Forwarded-For (rate limiting uses it)
ALLOW_PRIVATE_NETWORK=false # true only for self-hosted setups where customers' mail servers are on a private network
DEV_LOG_CHANNELS=false      # development only: "deliver" by logging when a customer has not connected a channel
